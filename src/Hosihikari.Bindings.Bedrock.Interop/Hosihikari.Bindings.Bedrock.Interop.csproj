<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hosihikari.Bindings.Bedrock.Interop</RootNamespace>
    <AssemblyName>Hosihikari.Bindings.Bedrock.Interop</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Hosihikari.Bindings.Bedrock.Interop</PackageId>
    <Version>1.21.3-r0</Version>
    <Authors>Hosihikari</Authors>
    <Description>Generated native-style .NET Interop for the Bedrock Dedicated Server (MCAPI) surface, dispatched by RVA and vtable slot.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Hosihikari/Bindings.Bedrock</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minecraft;bedrock;bds;mcapi;interop;hosihikari</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(AbiProjectPath)" Condition="'$(AbiProjectPath)' != ''" />
    <ProjectReference Include="../../../Bindings.Abi/src/Hosihikari.Bindings.Abi/Hosihikari.Bindings.Abi.csproj" Condition="'$(AbiProjectPath)' == ''" />
  </ItemGroup>

</Project>
