<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hosihikari.Bindings.Bedrock.Interop</RootNamespace>
    <AssemblyName>Hosihikari.Bindings.Bedrock.Interop</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Hosihikari.Bindings.Bedrock.Interop</PackageId>
    <Version>1.26.51-r0</Version>
    <Authors>Hosihikari</Authors>
    <Description>Generated native-style .NET Interop for the Bedrock Dedicated Server (MCAPI) surface, resolved by symbol name through the LeviLamina preloader.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HosihikariProjection/BedrockBinding</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minecraft;bedrock;bds;mcapi;interop;hosihikari</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(AbiProjectPath)" Condition="'$(AbiProjectPath)' != ''" />
    <ProjectReference Include="../../../Binding.Abi/src/Hosihikari.Bindings.Abi/Hosihikari.Bindings.Abi.csproj" Condition="'$(AbiProjectPath)' == ''" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- The native shim is distributed inside the package. Pass BedrockShimDll to include
       the build produced by native/BindingShim/build.ps1; packing without it stays valid. -->
  <ItemGroup Condition="'$(BedrockShimDll)' != '' and Exists('$(BedrockShimDll)')">
    <None Include="$(BedrockShimDll)" Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false" />
  </ItemGroup>

</Project>
